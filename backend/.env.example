PORT=4000
# Cantidad de proxies entre cliente y backend (0 para conexión directa)
TRUST_PROXY_HOPS=0
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=huellas_petid
DB_PORT=3306

# Seguridad de autenticación (usar secreto robusto en producción)
AUTH_SECRET=

# Proveedores externos de IA (Gemini / OpenAI) - opcional, con fallback inteligente integrado
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# APIs externas de mensajería automática (WhatsApp / SMS / Correo)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
# Plantilla aprobada de Meta con una variable de texto en el cuerpo
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
# Limita envíos de prueba a un solo número con código de país
WHATSAPP_TEST_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# Resend es obligatorio para el registro público por código
RESEND_API_KEY=
EMAIL_FROM=
MESSAGING_WEBHOOK_URL=

# Configuración clínica y scheduler automático
CLINIC_NAME=Clínica Veterinaria Huellas
CLINIC_PHONE=
# Número de atención con código de país para abrir WhatsApp desde el sitio
CLINIC_WHATSAPP=
CLINIC_ADDRESS=
AUTO_REMINDER_INTERVAL_MS=300000
